# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs / temp
*.log
*.tmp

# 런타임 캐시 — 로컬 경로·UUID 포함, git 추적 안 함
cache/

# 작업 데이터 — 사용자 사적 자료, git 추적 안 함 (폴더 구조 유지를 위해 .gitkeep만 추적)
tasks/*
!tasks/.gitkeep

# 프로젝트 특화 교훈 — 작성자 사적 누적물, git 추적 안 함 (폴더만 유지)
_local/*
!_local/.gitkeep

# 디스코드 폴더 봇·로컬 에이전트 비밀/런타임 — 공개 repo 커밋 금지
.env
.discord-state/
.bot-token*
.claude/settings.local.json
threads/
.agentlayer/

# Node / 빌드 산출물
node_modules/
dist/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
.env.local
storage/
