{
  "realm": "mes-dev",
  "enabled": true,
  "displayName": "MES Agent Hub (개발용 SSO 대역)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "mes-agent-hub",
      "name": "MES Agent Hub",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${APP_ORIGIN}/api/auth/callback"
      ],
      "webOrigins": [
        "${APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_ORIGIN}/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev-owner",
      "email": "dev-owner@example.com",
      "emailVerified": true,
      "firstName": "김운영",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-member",
      "email": "dev-member@example.com",
      "emailVerified": true,
      "firstName": "이담당",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-requester",
      "email": "dev-requester@example.com",
      "emailVerified": true,
      "firstName": "박요청",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
