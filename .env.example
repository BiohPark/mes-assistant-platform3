# 개발용 환경 변수 예시 — `.env`로 복사해서 쓴다 (pnpm setup:env). `.env`는 커밋하지 않는다.
# 아래 값은 로컬 개발 전용 가상 값이다. 운영 값은 서버 비밀 저장소에 둔다.

# --- docker compose (개발용 의존 서비스) ---
MARIADB_DATABASE=mes_hub
MARIADB_USER=mes
MARIADB_PASSWORD=dev-mariadb-password
MARIADB_ROOT_PASSWORD=dev-mariadb-root
MARIADB_PORT=3306
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
DEV_USER_PASSWORD=dev-password
SEED_DEV_ACCOUNTS=false
FAKE_OPENWEBUI_PORT=3101

# --- api ---
API_PORT=3000
# 직접 HTTPS는 선택: 아래 두 방식 중 하나만 설정. 모두 비우면 기존 HTTP 유지.
# PFX: 인증서·개인 키·체인이 들어 있는 파일. 비밀번호는 로그/XML에 넣지 않는다.
# Windows 경로는 작은따옴표('D:\...')나 / 구분자로 쓴다. 큰따옴표 안에서는 \n 등이 줄바꿈으로 바뀌어 경로가 깨진다.
# HTTPS_PFX_FILE='D:\mes-hub\config\certificates\server.pfx'
# HTTPS_PFX_PASSPHRASE=
# PEM: 인증서(full chain)와 개인 키를 모두 지정. CA 체인 파일은 선택.
# HTTPS_CERT_FILE='D:\mes-hub\config\certificates\server-chain.pem'
# HTTPS_KEY_FILE='D:\mes-hub\config\certificates\server-key.pem'
# HTTPS_CA_FILE='D:\mes-hub\config\certificates\ca-chain.pem'
# 사내 CA 신뢰: deploy:local/verify-release는 HTTPS_CA_FILE 또는 프로세스 시작 전
# NODE_EXTRA_CA_CERTS(PEM CA 파일)를 사용. PFX 방식은 NODE_EXTRA_CA_CERTS를 사용한다.
# NODE_EXTRA_CA_CERTS는 Node 프로세스를 시작하기 전에 셸/서비스 환경에 설정한다.
AUTH_MODE=local
# 선택: 이메일 미설정 계정에 {loginId}@{도메인}을 응답할 때만 사용 (DB 저장·백필 없음)
# 도메인 전체 253자 이하, 구간 1–63자 영숫자·하이픈 (앞뒤 하이픈 금지), 영문 최상위 도메인 2자 이상
DEFAULT_EMAIL_DOMAIN=example.com
# AUTH_MODE=oidc 사용 시 아래 OIDC_* 설정과 Keycloak이 필요하다: docker compose --profile oidc up -d
APP_ORIGIN=http://localhost:5173
# 배포 시 api가 web/dist를 자동 탐색. 다른 위치에 둘 때만 절대 경로로 지정한다.
# WEB_DIST_DIR=
DATABASE_URL=mysql://mes:dev-mariadb-password@localhost:3306/mes_hub
SESSION_SECRET=dev-session-secret-change-me-32chars-min
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=12
AUTH_ATTEMPT_MAX=10
AUTH_ATTEMPT_WINDOW_MS=600000
# 신뢰하는 리버스 프록시(IIS 등) 뒤에서만: 프록시 IP/서브넷 목록(권장, 예 127.0.0.1) 또는 홉 수. true(모두 신뢰)는 거부. API 포트 직접 접근은 방화벽으로 차단
TRUST_PROXY=false
# IP별 동시 진행 중 로그인·가입 상한(실패 상한 AUTH_ATTEMPT_MAX와 별개)
AUTH_IP_PENDING_MAX=100
OIDC_ISSUER=http://localhost:8180/realms/mes-dev
OIDC_CLIENT_ID=mes-agent-hub
OIDC_CLIENT_SECRET=dev-oidc-client-secret
# 최초 System Owner — local: login_id / oidc: preferred_username 또는 sub (쉼표 구분)
# 최초 배포 직후 관리자가 이 ID로 먼저 가입할 것 — SO가 한 명이라도 생기면 이 목록은 더 적용되지 않음
INITIAL_SYSTEM_OWNERS=dev-owner
LLM_MODE=mock
LLM_PRESET=openwebui
LLM_BASE_URL=http://localhost:3101
LLM_API_KEY=dev-fake-key
# LLM_DEFAULT_MODEL=glm-5.2
# OpenWebUI 대화 요청 방식 기본값 — auto(세션 우선, 시작 전 거부·형식 불일치면 기존 방식) | session | direct(기존 스트리밍). 관리 설정이 우선
LLM_OWUI_MODE=auto
# 세션 모드 완료 뒤 OpenWebUI 채팅 삭제 기본값(true|false). 관리 설정이 우선
LLM_OWUI_CLEANUP=true
FILE_STORAGE_ROOT=./storage
FILE_MAX_BYTES=52428800
FILE_MAX_PER_REQUEST=20
# 첫 응답 5분 / 첨부 10분 / 본문·생각 청크 사이 무응답 5분 (밀리초, 기존 설정 우선)
REQUEST_FIRST_TOKEN_MS=300000
REQUEST_FILES_FIRST_TOKEN_MS=600000
REQUEST_IDLE_MS=300000
REQUEST_LEASE_MS=30000
REQUEST_KEEPALIVE_MS=10000
REQUEST_SWEEP_MS=30000
REQUEST_FLUSH_MS=250
REQUEST_BUDGET_BYTES=262144
REQUEST_MAX_ACTIVE=20
