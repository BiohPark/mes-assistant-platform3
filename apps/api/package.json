{
  "name": "@mes/api",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0"
  },
  "dependencies": {
    "@mes/contracts": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist dist/main.js\""
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
